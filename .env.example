# LLM Chat Interface — environment template.
# Copy to `.env` (gitignored) and fill in real values. See PROJECT_PLAN.md §5.

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=3001
APP_ENV=development

# --- Data stores ---
DATABASE_URL=postgresql+asyncpg://llmchat:llmchat@localhost:5432/llmchat
TEST_DATABASE_URL=postgresql+asyncpg://llmchat:llmchat@localhost:5432/llmchat_test
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# --- Auth ---
# Generate once per machine: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-64-hex-random
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Feature flags ---
REGISTRATION_ENABLED=true
FIRST_USER_IS_ADMIN=true

# --- Rate limits ---
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_API_PER_HOUR=120
RATE_LIMIT_LOGIN_PER_15MIN=5
MAX_MESSAGE_CHARS=16000

# --- LLM upstream (OpenAI-compatible; mock server runs on :8001) ---
LLM_API_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENT=2
LLM_LIVE_TEST=0
LLM_VISION_ENABLED=true

# --- File attachments ---
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_MB=100
DOC_MAX_CHARS=100000

# --- Mock LLM server ---
MOCK_LLM_PORT=8001
MOCK_LLM_REPLY=This is a mock reply from the mock LLM server.
MOCK_VISION_REPLY=I can see the image.
MOCK_LLM_LATENCY_MS=0
MOCK_LLM_CHUNKS=12
